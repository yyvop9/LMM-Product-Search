# .gitignore

# ----------------------------------------------------------------
# 1. Secrets (!!! 가장 중요 !!!)
# ----------------------------------------------------------------
# 모든 .env 파일 (DB비밀번호, API 키 등)
.env
.env.*
*.env

# ----------------------------------------------------------------
# 2. AI 데이터 & 모델 (용량 관리)
# ----------------------------------------------------------------
# (AI 담당자 요청) 원시 데이터 폴더
data/
datasets/

# (AI 담당자 요청) 학습된 모델 파일
*.pth
*.pt
*.h5
*.onnx
saved_models/

# (AI 담당자 요청) 대용량 압축 파일
*.zip
*.gz
*.tar.gz
*.7z

# 기타 데이터 파일 (피클, 파케이 등)
*.pkl
*.parquet

# ----------------------------------------------------------------
# 3. Python (AI/백엔드 공통 환경)
# ----------------------------------------------------------------
# (팀원 요청) 가상환경 폴더
venv/
.venv/
env/
ENV/

# 파이썬 캐시 파일
__pycache__/
*.py[cod]

# Jupyter Notebook 체크포인트
.ipynb_checkpoints

# ----------------------------------------------------------------
# 4. Node.js (프론트엔드 환경)
# ----------------------------------------------------------------
# (팀원 요청) 의존성 폴더 (수만 개의 파일)
node_modules/

# React 빌드 결과물
build/
dist/

# 로그 파일
npm-debug.log*
yarn-error.log*

# ----------------------------------------------------------------
# 5. OS & IDE (개인 환경 정리)
# ----------------------------------------------------------------
# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# VSCode
.vscode/

# PyCharm
.idea/